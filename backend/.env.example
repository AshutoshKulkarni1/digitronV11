# ===================================================
# Digitron Associates — Environment Variables Template
# Copy this file to backend/.env and populate with your credentials.
# To generate secure keys & hashes, run: npm run generate:secrets
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB Atlas URI)
# Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/digitron?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/digitron?retryWrites=true&w=majority"

# Authentication Secrets
# Generate random 256-bit secrets with: npm run generate:secrets
# Minimum 32 characters required in production!
JWT_SECRET=""
SESSION_SECRET=""
SESSION_STORE="mongo"

# Frontend / Allowed Origins (Comma-separated for local & production)
FRONTEND_URL="http://localhost:5173,https://digitronx.vercel.app"

# Admin Dashboard Credentials
ADMIN_USERNAME="admin"
# Bcrypt hash of admin password (Cost factor 10)
# Generate a new hash with: npm run generate:secrets "your-secure-password"
ADMIN_PASSWORD_HASH=""

# Email Service (Nodemailer Gmail App Password for customer quote notifications)
# 1. Enable 2FA on Google Account -> 2. Generate App Password for Mail
EMAIL_USER="your-store-email@gmail.com"
EMAIL_PASS="your-16-char-app-password"

# Google OAuth (Optional: Enables customer Google Login)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="https://digitronx.vercel.app/api/auth/google/callback"
